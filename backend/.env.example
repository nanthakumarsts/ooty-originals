# ==============================================================================
#                  OOTY ORIGINALS - BACKEND ENVIRONMENT CONFIG
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the backend root directory:
#      cp .env.example .env
# 2. Fill in your actual credentials below (especially Razorpay & Shiprocket).
# 3. Restart the backend server for changes to take effect:
#      node server.js  (or pm2 restart server)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & DOMAIN URLS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Public URLs (Used for CORS permissions and links generated in email templates)
# In local development:
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# In live production (replace with your real domains, e.g.):
# API_URL=https://api.ootyoriginals.in
# CLIENT_URL=https://ootyoriginals.in
# ADMIN_URL=https://admin.ootyoriginals.in

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ooty_originals

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a long, secure random string for production (at least 32 characters)
JWT_SECRET=ooty-originals-jwt-super-secret-key-min-32-chars-long
JWT_EXPIRES=7d

# Default administrator account (Created on first run / db:setup)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@ootyoriginals.in
ADMIN_PASSWORD=Admin@123

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP) - Order confirmation, Password reset, Return emails
# ------------------------------------------------------------------------------
# Option A: Using Gmail (Recommended & Easiest)
#   1. Go to Google Account > Security > 2-Step Verification > App passwords.
#   2. Generate a 16-letter App Password for "Mail".
#   3. Paste your email and the 16-letter app password below.
SMTP_USER=
SMTP_PASS=

# Display name and sender address on customer emails:
MAIL_FROM_NAME="Ooty Originals"
MAIL_FROM="Ooty Originals <hi@ootyoriginals.in>"

# Option B: Custom SMTP (cPanel / Zoho / SendGrid / AWS SES)
# If using custom mail server, uncomment and configure these lines:
# SMTP_HOST=smtp.yourmailserver.com
# SMTP_PORT=465
# SMTP_SECURE=true

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Payments & Automated Refunds)
# ------------------------------------------------------------------------------
# How to get your keys:
#   1. Log in to your Razorpay Dashboard (https://dashboard.razorpay.com).
#   2. Go to: Settings > API Keys > Generate Key.
#   3. For LIVE payments, ensure Dashboard is in 'Live Mode' (keys start with rzp_live_).
#   4. For TEST payments, use 'Test Mode' (keys start with rzp_test_).
#
# NOTE: If left blank, the store automatically runs in mock mode for safe offline testing.
# When keys are provided, online checkout and return/cancellation refunds work automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 6. SHIPROCKET SHIPPING & REVERSE PICKUP
# ------------------------------------------------------------------------------
# How to configure:
#   1. Use the exact email and password registered with your Shiprocket account
#      (https://app.shiprocket.in).
#   2. SHIPROCKET_PICKUP_LOCATION: The exact Nickname of your registered pickup address
#      in Shiprocket Dashboard (Settings > Pickup Address). Usually "warehouse" or "Primary".
#
# NOTE: If password contains special characters (like #, $, &), enclose it in quotes: "..."
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=warehouse

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & REVERSE PROXY
# ------------------------------------------------------------------------------
# Max API calls allowed per minute per IP address
RATE_LIMIT_PER_MINUTE=240
ADMIN_RATE_LIMIT_PER_MINUTE=600

# Set to 1 if deployed behind a reverse proxy (Nginx, Apache, Cloudflare, cPanel).
# Set to 0 for local development.
TRUST_PROXY=0
